{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-sisger-ucb-uc-132123"
		},
		"sa_omnicanal_accountKey": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"accountKey\"de \"sa_omnicanal\""
		},
		"sql_omnicanal_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"sql_omnicanal\""
		},
		"sa_omnicanal_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sasisger12312.dfs.core.windows.net/"
		},
		"sql_omnicanal_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sisger12313232.database.windows.net"
		},
		"sql_omnicanal_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_ventas"
		},
		"sql_omnicanal_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "AaronHerbas"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/sa_omnicanal')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('sa_omnicanal_properties_typeProperties_url')]",
					"accountKey": {
						"type": "SecureString",
						"value": "[parameters('sa_omnicanal_accountKey')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/sql_omnicanal')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('sql_omnicanal_properties_typeProperties_server')]",
					"database": "[parameters('sql_omnicanal_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('sql_omnicanal_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('sql_omnicanal_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/calificaciones_csv')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "sa_omnicanal",
					"type": "LinkedServiceReference"
				},
				"folder": {
					"name": "csv"
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": "calificaciones.csv",
						"fileSystem": "raw"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": [
					{
						"name": "calificacion_id",
						"type": "String"
					},
					{
						"name": "pedido_id",
						"type": "String"
					},
					{
						"name": "cliente_id",
						"type": "String"
					},
					{
						"name": "fecha_calificacion",
						"type": "String"
					},
					{
						"name": "puntuacion",
						"type": "String"
					},
					{
						"name": "comentario",
						"type": "String"
					}
				]
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/sa_omnicanal')]"
			]
		}
	]
}